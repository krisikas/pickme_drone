<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pickme_missions</name>
  <version>0.1.0</version>
  <description>Mission logic for PickmeDrone — gate racing, patrol, mapping, etc. Mounted as volume in dev container.</description>
  <maintainer email="dev@pickmedrone.local">Developer</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>pickme_interfaces</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
