# ── Target Board & Deployment Connection ──
BOARD=radxa
DRONE_IP=10.42.0.1
DRONE_USER=ubuntu

# ── Flight Controller (Micro-XRCE-DDS for ROS 2) ──
FCU_DEVICE=/dev/ttyS4
FCU_BAUD=921600
PX4_MSGS_BRANCH_REAL=release/1.15
PX4_MSGS_BRANCH_SIM=release/1.16

# ── MAVLink Router (QGroundControl Telemetry Bridge) ──
ENABLE_MAVLINK_ROUTER=true
MAVLINK_DEVICE=/dev/ttyACM0
MAVLINK_BAUD=921600
MAVLINK_TCP_PORT=5760
MAVLINK_QGC_IP=10.42.0.255
MAVLINK_QGC_PORT=14550

# ── Camera Driver (realsense or oakd) ──
CAMERA_TYPE=realsense
RGB_WIDTH=640
RGB_HEIGHT=480
RGB_FPS=30
DEPTH_WIDTH=640
DEPTH_HEIGHT=480
DEPTH_FPS=30
ENABLE_POINTCLOUD=true

# ── CPU Core Affinity (Rockchip RK3588: 0-3 little Cortex-A55, 4-7 big Cortex-A76) ──
CAMERA_CPUSET=4,5
CORE_CPUSET=4,5
PERCEPTION_CPUSET=6,7
FCU_CPUSET=2
FOXGLOVE_CPUSET=3
DEV_CPUSET=1

# ── SLAM & Perception ──
SLAM_ENABLE=false

# ── Core & Flight Safety ──
USE_SIM_TIME=false
LAUNCH_OFFBOARD=false
PUBLISH_CAMERA_TF=false
ROS_DOMAIN_ID=0

# ── Foxglove Studio Telemetry Bridge ──
FOXGLOVE_PORT=8765
